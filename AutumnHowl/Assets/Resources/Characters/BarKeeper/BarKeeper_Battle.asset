  obstacleLayoutPrefab: {fileID: 7165149278535518001, guid: ebbfc05a6488c7ee3894b5f84dd7f782, type: 3}
  openingText:
    frames:
    - name: Barkeeper
      chatContent: Welcome to the Active Battle Grid!
      portrait: {fileID: -751729575, guid: d1a0ca5211c3884cbb0d80af09011836, type: 3}
      chatterVoice: {fileID: 11400000, guid: 65b3fc3a5355944d6b632355a061e2b2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 1
      preventTextSkipping: 0
      preventTextContinuing: 0
      autoProgressOnComplete: 0
    - name: Barkeeper
      chatContent: Let's start with teaching you how to swing that big sword of yours!
      portrait: {fileID: -751729575, guid: d1a0ca5211c3884cbb0d80af09011836, type: 3}
      chatterVoice: {fileID: 11400000, guid: 65b3fc3a5355944d6b632355a061e2b2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 1
      preventTextSkipping: 0
      preventTextContinuing: 0
      autoProgressOnComplete: 0
    - name: Barkeeper
      chatContent: When attacking, you will be presented with an Attack Compass.
        Its needle represents your sword's direction.
      portrait: {fileID: 866953318, guid: d1a0ca5211c3884cbb0d80af09011836, type: 3}
      chatterVoice: {fileID: 11400000, guid: 65b3fc3a5355944d6b632355a061e2b2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 1
      preventTextSkipping: 0
      preventTextContinuing: 0
      autoProgressOnComplete: 0
    - name: Barkeeper
      chatContent: Using it, you can choose the direction and distance of your swing.
        A further swing does more damage, but burns more of your energy.
      portrait: {fileID: 866953318, guid: d1a0ca5211c3884cbb0d80af09011836, type: 3}
      chatterVoice: {fileID: 11400000, guid: 65b3fc3a5355944d6b632355a061e2b2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 1
      preventTextSkipping: 0
      preventTextContinuing: 0
      autoProgressOnComplete: 0
    - name: Barkeeper
      chatContent: Go ahead and attack the dummy!
      portrait: {fileID: -751729575, guid: d1a0ca5211c3884cbb0d80af09011836, type: 3}
      chatterVoice: {fileID: 11400000, guid: 65b3fc3a5355944d6b632355a061e2b2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 1
      preventTextSkipping: 0
      preventTextContinuing: 0
      autoProgressOnComplete: 0
    OnFinish:
      m_PersistentCalls:
        m_Calls: []

    - rid: 5087324151564468224
      type: {class: BattleWave, ns: , asm: Assembly-CSharp}
      data:
        waveDescription: Learn To Defend
        waveStartText:
          frames:
          - name: Barkeeper
            chatContent: Excellent work! You knocked 'em silly!
            portrait: {fileID: 866953318, guid: d1a0ca5211c3884cbb0d80af09011836, type: 3}
            chatterVoice: {fileID: 11400000, guid: 65b3fc3a5355944d6b632355a061e2b2, type: 2}
            OnFrameCompleted:
              m_PersistentCalls:
                m_Calls: []
            displayMode: 1
            preventTextSkipping: 0
            preventTextContinuing: 0
            autoProgressOnComplete: 0
          - name: Barkeeper
            chatContent: Swinging such a big sword can get pretty exhausting though.
              So you'll need to be able to rest when you run out of power.
            portrait: {fileID: 866953318, guid: d1a0ca5211c3884cbb0d80af09011836, type: 3}
            chatterVoice: {fileID: 11400000, guid: 65b3fc3a5355944d6b632355a061e2b2, type: 2}
            OnFrameCompleted:
              m_PersistentCalls:
                m_Calls: []
            displayMode: 1
            preventTextSkipping: 0
            preventTextContinuing: 0
            autoProgressOnComplete: 0
          - name: Barkeeper
            chatContent: Defending will subtract any incoming damage by your defense
              stat, but it also gives you time to rest and regain some power!
            portrait: {fileID: 866953318, guid: d1a0ca5211c3884cbb0d80af09011836, type: 3}
            chatterVoice: {fileID: 11400000, guid: 65b3fc3a5355944d6b632355a061e2b2, type: 2}
            OnFrameCompleted:
              m_PersistentCalls:
                m_Calls: []
            displayMode: 1

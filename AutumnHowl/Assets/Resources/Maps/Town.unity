--- !u!114 &1357334687
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1357334685}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7fdcdaaf8da5a1891ba5d7c844bf7a71, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  overrideExistingEvents: 0
  textEvent:
    frames:
    - name: Barkeeper
      chatContent: '*Yeah, I''m sure you''ll kick tail out there with that huge sword.
        But if you change your mind, let me know! I''m always down for a good fight!'
      portrait: {fileID: 866953318, guid: d1a0ca5211c3884cbb0d80af09011836, type: 3}
      chatterVoice: {fileID: 11400000, guid: 65b3fc3a5355944d6b632355a061e2b2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 1
      preventTextSkipping: 0
      preventTextContinuing: 0
      autoProgressOnComplete: 0
    - name: Barkeeper
      chatContent: '*{col=key}The Tavern{col=} is closed right now since Nicc set
        off a smoke bomb next to the liqour rack and blew a hole in the floor.'
      portrait: {fileID: 866953318, guid: d1a0ca5211c3884cbb0d80af09011836, type: 3}
      chatterVoice: {fileID: 11400000, guid: 65b3fc3a5355944d6b632355a061e2b2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 1
      preventTextSkipping: 0
      preventTextContinuing: 0
      autoProgressOnComplete: 0
    - name: Barkeeper
      chatContent: '*But come by sometime when we reopen if you wanna drink or a
        {col=key}Real Challenge!'
      portrait: {fileID: -751729575, guid: d1a0ca5211c3884cbb0d80af09011836, type: 3}
      chatterVoice: {fileID: 11400000, guid: 65b3fc3a5355944d6b632355a061e2b2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 1
      preventTextSkipping: 0
      preventTextContinuing: 0
      autoProgressOnComplete: 0
    OnFinish:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1774403811}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: SetActive
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine

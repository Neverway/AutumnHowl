--- !u!114 &547352584
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 547352583}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7fdcdaaf8da5a1891ba5d7c844bf7a71, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  overrideExistingEvents: 0
  textEvent:
    frames:
    - name: ???
      chatContent: '*Hey! I haven''t seen ya around before!'
      portrait: {fileID: 866953318, guid: d1a0ca5211c3884cbb0d80af09011836, type: 3}
      chatterVoice: {fileID: 11400000, guid: 65b3fc3a5355944d6b632355a061e2b2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 1
      preventTextSkipping: 0
      preventTextContinuing: 0
      autoProgressOnComplete: 0
    - name: Barkeeper
      chatContent: '*The name''s {col=key}Nacc{col=} & I have a knack for fighting!
        I run the tavern in town!'
      portrait: {fileID: -751729575, guid: d1a0ca5211c3884cbb0d80af09011836, type: 3}
      chatterVoice: {fileID: 11400000, guid: 65b3fc3a5355944d6b632355a061e2b2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 1
      preventTextSkipping: 0
      preventTextContinuing: 0
      autoProgressOnComplete: 0
    - name: Barkeeper
      chatContent: '*You''re not planning to go into the forest without a lantern,
        are ya?'
      portrait: {fileID: 866953318, guid: d1a0ca5211c3884cbb0d80af09011836, type: 3}
      chatterVoice: {fileID: 11400000, guid: 65b3fc3a5355944d6b632355a061e2b2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 1
      preventTextSkipping: 0
      preventTextContinuing: 0
      autoProgressOnComplete: 0
    - name: Autumn
      chatContent: '*...'
      portrait: {fileID: 779807480, guid: f4bcb4a75ef1466f192f8ea870ce6ae3, type: 3}
      chatterVoice: {fileID: 11400000, guid: 8627461905224cf4686012d99980d1c2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 1
      preventTextSkipping: 0
      preventTextContinuing: 0
      autoProgressOnComplete: 0
    - name: Barkeeper
      chatContent: '*You should know that being in the dark this close to the barrier
        is a quick way to get yourself killed!'
      portrait: {fileID: 866953318, guid: d1a0ca5211c3884cbb0d80af09011836, type: 3}
      chatterVoice: {fileID: 11400000, guid: 65b3fc3a5355944d6b632355a061e2b2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 1
      preventTextSkipping: 0
      preventTextContinuing: 0
      autoProgressOnComplete: 0
    - name: Barkeeper
      chatContent: '*Here, take one! I''ve got plenty!'
      portrait: {fileID: 866953318, guid: d1a0ca5211c3884cbb0d80af09011836, type: 3}
      chatterVoice: {fileID: 11400000, guid: 65b3fc3a5355944d6b632355a061e2b2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 1
      preventTextSkipping: 0
      preventTextContinuing: 0
      autoProgressOnComplete: 0
    - name: Lantern Get
      chatContent: '*You got {col=key}The Lantern!'
      portrait: {fileID: 1875603287, guid: 081740101fd2f03f9a9f9cc1d0baf3c0, type: 3}
      chatterVoice: {fileID: 0}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 0
      preventTextSkipping: 0
      preventTextContinuing: 0
      autoProgressOnComplete: 0
    - name: Barkeeper
      chatContent: '*My brothers and I love collecting stuff!'
      portrait: {fileID: 866953318, guid: d1a0ca5211c3884cbb0d80af09011836, type: 3}
      chatterVoice: {fileID: 11400000, guid: 65b3fc3a5355944d6b632355a061e2b2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 1
      preventTextSkipping: 0
      preventTextContinuing: 0
      autoProgressOnComplete: 0
    - name: Barkeeper
      chatContent: '*If you have any {col=key}Wearable Items{col=} you wanna toss
        my way, I''ll give ya a special deal for ''um!'
      portrait: {fileID: 866953318, guid: d1a0ca5211c3884cbb0d80af09011836, type: 3}
      chatterVoice: {fileID: 11400000, guid: 65b3fc3a5355944d6b632355a061e2b2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 1
      preventTextSkipping: 0
      preventTextContinuing: 0
      autoProgressOnComplete: 0
    - name: Barkeeper
      chatContent: '*If you are plannin on headin'' in there now, do you want some
        fighting tips?'
      portrait: {fileID: -751729575, guid: d1a0ca5211c3884cbb0d80af09011836, type: 3}
      chatterVoice: {fileID: 11400000, guid: 65b3fc3a5355944d6b632355a061e2b2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 1
      preventTextSkipping: 0
      preventTextContinuing: 0
      autoProgressOnComplete: 0
    OnFinish:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 547352585}
          m_TargetAssemblyTypeName: Func_TextChoice, Assembly-CSharp
          m_MethodName: StartChoices
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  OnCallFailed:
    m_PersistentCalls:
      m_Calls: []

--- !u!114 &2007030159
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2007030156}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7fdcdaaf8da5a1891ba5d7c844bf7a71, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  overrideExistingEvents: 0
  textEvent:
    frames:
    - name: 
      chatContent: '{spd=0.05}In this world, time no longer flows{spd=3} {spd=0.05}'
      portrait: {fileID: 0}
      chatterVoice: {fileID: 11400000, guid: 8627461905224cf4686012d99980d1c2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 4
      preventTextSkipping: 1
      preventTextContinuing: 1
      autoProgressOnComplete: 1
    - name: 
      chatContent: '{spd=0.05}The moon never sets, and the sun never rises{spd=3}
        {spd=0.05}'
      portrait: {fileID: 0}
      chatterVoice: {fileID: 11400000, guid: 8627461905224cf4686012d99980d1c2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 4
      preventTextSkipping: 1
      preventTextContinuing: 1
      autoProgressOnComplete: 1
    - name: 
      chatContent: '{spd=0.05}The lands are cloaked in a forest of eternal Autumn{spd=3}
        {spd=0.05}'
      portrait: {fileID: 0}
      chatterVoice: {fileID: 11400000, guid: 8627461905224cf4686012d99980d1c2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 4
      preventTextSkipping: 1
      preventTextContinuing: 1
      autoProgressOnComplete: 1
    - name: 
      chatContent: '{spd=0.05}And beyond the forest barrier lurks an evil beast{spd=3}
        {spd=0.05}'
      portrait: {fileID: 0}
      chatterVoice: {fileID: 11400000, guid: 8627461905224cf4686012d99980d1c2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 4
      preventTextSkipping: 1
      preventTextContinuing: 1
      autoProgressOnComplete: 1
    - name: 
      chatContent: '{spd=0.05}Legend tells of a mythical blade that can defeat it,{spd=0.2} 
        {spd=0.05}however...{spd=3} {spd=0.05}'
      portrait: {fileID: 0}
      chatterVoice: {fileID: 11400000, guid: 8627461905224cf4686012d99980d1c2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 4
      preventTextSkipping: 1
      preventTextContinuing: 1
      autoProgressOnComplete: 1
    - name: 
      chatContent: '{spd=0.05}It''s just a bit bigger than you were expecting{spd=25}
        {spd=0.05}'
      portrait: {fileID: 0}
      chatterVoice: {fileID: 11400000, guid: 8627461905224cf4686012d99980d1c2, type: 2}
      OnFrameCompleted:
        m_PersistentCalls:
          m_Calls: []
      displayMode: 4
      preventTextSkipping: 1
      preventTextContinuing: 1
      autoProgressOnComplete: 1
    OnFinish:
      m_PersistentCalls:
        m_Calls: []
  OnCallFailed:
    m_PersistentCalls:
      m_Calls: []
